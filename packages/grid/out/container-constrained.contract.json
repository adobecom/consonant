  "decisions": [
    {
      "id": "CON_BASIS_1440",
      "question": "The caps are computed from a hard-coded 1440 basis rather than from --s2a-grid-max-width. Should they follow the standard container up to 1920 in HD?",
      "state": "open",
      "owner": "William Blanton",
      "evidence": "If the standard container rises to 1920 at XL but container-8 stays pinned to a 1440 basis, a 'two-thirds width' section quietly becomes a smaller share of the page in HD. Deliberate or not, it should be stated."
    },
    {
      "id": "CON_DOC_1024",
      "question": "Will's hosted demo documents these under a heading reading 'Desktop Constraint Variations (1024px+)', but they carry no media query at all in either stylesheet.",
      "state": "open",
      "owner": "William Blanton",
      "evidence": "Stale heading on acom-prototypes.vercel.app/s2a-grids/col-system.html, and 1024 is the same wrong number that caused the sectional-token reflow bug. Worth correcting on the page so nobody implements to it."
    },
    {
      "id": "CON_MODIFIER_ALONE",
      "question": "Should .container-6 used on its own be an error? Alone it sets only a cap — no centring, no side margins — so a section that forgets .container silently sits flush left.",
      "state": "open",
      "owner": "Matthew Huntsberry",
      "evidence": "The stylesheet comment calls them 'Desktop Container Modifiers' but nothing enforces the pairing. Caught while building the Storybook demo, which rendered .container-6 alone and produced a left-aligned box."
    }
