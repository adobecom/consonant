  "decisions": [
    {
      "id": "a-rebuilt-from-code",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "The first contract for this component was scaffolded from the design file and described a row of six boxes.",
      "chose": "Rebuilt from the implementation, as badge, button and icon were",
      "decision": "The real component is a sized circle and an image, twenty-four CSS rules in total. The scaffolder had transcribed the design file's node tree — the gradient artwork, the initials text, the guest glyph and the stroke — as anatomy, laid them out as flex siblings, and hid none of them, so the preview drew six boxes side by side.",
      "fix": "none",
      "evidence": "dist/components/avatar/avatar.js is 2,193 bytes; the scaffolded contract was roughly 900 lines with 327 refusals."
    },
    {
      "id": "a-style-axis",
      "status": "open",
      "confidence": "high",
      "owner": "Matt",
      "question": "The design file has a Style axis with four values — User image, Gradient image, Initials, Guest — and the implementation has no such property.",
      "chose": "Left it out of props and recorded it here",
      "fix": "Ask the Spectrum team whether the generated gradient, the initials and the guest glyph are meant to ship. Today an avatar renders whatever src points at and nothing else, so a consumer wanting initials has to draw them.",
      "evidence": "Avatar.base.d.ts declares src, alt, size, outline, disabled and decorative. There is no style property, and avatar.js renders one <img>."
    },
    {
      "id": "a-size-naming",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "The design labels each size with its pixel box; the code uses the rung alone.",
      "chose": "The contract carries the code value and maps to the design label",
      "decision": "size is \"500\" in code and \"500 (40x40)\" in the file. The value map in the size prop is the translation.",
      "fix": "none",
      "evidence": "AVATAR_VALID_SIZES is a numeric tuple; the Figma Size axis carries the labels."
    },
    {
      "id": "a-sample-art",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "An avatar with no src is an empty circle, so the preview had nothing to show.",
      "chose": "Export the design's own placeholder photo into the package and name it on the slot",
      "decision": "The sample is the design file's art, not something invented. It is a slot default, so it describes what the design puts there; it is never a value the component ships with.",
      "fix": "The schema has no key for a media slot's sample art, so it is recorded under default.props, whose description covers the design's overrides on the instance. A `sample` key would read better.",
      "evidence": "exported from the Size=1400 User image variant's Photo layer."
    },
    {
      "id": "a-image-source",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "The renderer had no way to emit an image whose src is a prop, so the preview drew a placeholder comment.",
      "chose": "Declared the image part as an asset whose prop is the source",
      "decision": "The asset form already emitted <img src=…>, but required a manifest and field because it was built for lookup tables like the product icons. An avatar has no key to resolve: src is the source. Those two fields are now optional.",
      "fix": "none",
      "evidence": "The slot is kept alongside: it records what the design fills the picture with, including the exported sample."
    },
    {
      "id": "a-outline-attr",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "Toggling outline changed nothing in the preview.",
      "chose": "Declare the attribute the styling keys on",
      "decision": "The image's outline rule is written against [data-outline=\"true\"], and the prop declared no attr, so the generated component never set one. A prop that conditions styling has to name the attribute that carries it.",
      "fix": "none",
      "evidence": "The rendered root carried data-size and data-disabled but no data-outline, so the rule could not match."
    }
  ],
