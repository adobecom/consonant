{
  "$schema": "../../../spec-dictionary/southleft/contract.schema.json",
  "id": "s2a.collapsible",
  "name": "Collapsible",
  "version": "1.2.1",
  "status": "draft",
  "description": "A disclosure: a trigger that shows and hides a region of content. Open or closed is a prop a consumer sets, not an interaction state.",
  "archetype": "accordion",
  "semantics": {
    "element": "div"
  },
  "props": [
    {
      "name": "content",
      "type": "text",
      "description": "Children. A Figma Slot; anything may be placed here.",
      "default": "nothing",
      "bindings": {
        "figma": {
          "kind": "NONE",
          "property": "—"
        },
        "code": {
          "prop": "content"
        }
      }
    },
    {
      "name": "size",
      "type": {
        "enum": [
          "default",
          "lg"
        ]
      },
      "default": "\"default\"",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size"
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "open",
      "type": "boolean",
      "default": "false",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "State",
          "valueMap": {
            "true": "open",
            "false": "closed"
          }
        },
        "code": {
          "prop": "open"
        }
      }
    },
    {
      "name": "style",
      "type": {
        "enum": [
          "default",
          "control"
        ]
      },
      "default": "\"default\"",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Style"
        },
        "code": {
          "prop": "style"
        }
      }
    },
    {
      "name": "label",
      "type": "text",
      "description": "Exists in the component, has no design counterpart.",
      "default": "\"See what's included:\"",
      "bindings": {
        "figma": {
          "kind": "NONE",
          "property": "—"
        },
        "code": {
          "prop": "label"
        }
      }
    }
  ],
