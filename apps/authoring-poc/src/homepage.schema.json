{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2a.local/schemas/homepage-section-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "component", "componentVersion", "props", "items"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "component": {
      "enum": [
        "global-navigation",
        "router-marquee",
        "hub-router",
        "media-section",
        "news-section",
        "product-router",
        "site-footer"
      ]
    },
    "componentVersion": { "const": 1 },
    "props": { "$ref": "#/$defs/fields" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "component": { "const": "router-marquee" } } },
      "then": { "properties": { "items": { "type": "array", "maxItems": 5 } } }
    },
    {
      "if": { "properties": { "component": { "const": "hub-router" } } },
      "then": { "properties": { "items": { "type": "array", "maxItems": 8 } } }
    },
    {
      "if": { "properties": { "component": { "const": "media-section" } } },
      "then": { "properties": { "items": { "type": "array", "maxItems": 10 } } }
    },
    {
      "if": { "properties": { "component": { "const": "news-section" } } },
      "then": { "properties": { "items": { "type": "array", "maxItems": 6 } } }
    },
    {
      "if": { "properties": { "component": { "const": "product-router" } } },
      "then": { "properties": { "items": { "type": "array", "maxItems": 18 } } }
    },
    {
      "if": { "properties": { "component": { "const": "global-navigation" } } },
      "then": { "properties": { "items": { "type": "array", "maxItems": 6 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "body",
        "ctaLabel",
        "ctaHref",
        "imageAssetId",
        "imageAlt"
      ],
      "properties": {
        "eyebrow": { "title": "Eyebrow", "type": "string", "maxLength": 80 },
        "title": { "title": "Headline", "type": "string", "maxLength": 180 },
        "body": { "title": "Description", "type": "string", "maxLength": 600 },
        "ctaLabel": {
          "title": "Link label",
          "type": "string",
          "maxLength": 60
        },
        "ctaHref": {
          "title": "Link URL",
          "type": "string",
          "maxLength": 2048,
          "format": "safe-link"
        },
        "imageAssetId": {
          "enum": [
            "",
            "story-1",
            "story-2",
            "story-3",
            "home-acrobat",
            "home-upscale",
            "home-documents",
            "home-models",
            "home-harmonize",
            "home-tools",
            "home-michelle",
            "hub-creative",
            "hub-firefly",
            "hub-acrobat",
            "hub-business",
            "hub-students",
            "hero-acrobat",
            "hero-creative",
            "hero-firefly",
            "hero-business",
            "hero-education"
          ]
        },
        "videoAssetId": {
          "title": "Background video",
          "enum": [
            "",
            "video-hero-acrobat",
            "video-hero-creative",
            "video-hero-firefly",
            "video-hero-business",
            "video-hero-education",
            "video-hub-creative",
            "video-hub-firefly",
            "video-hub-acrobat",
            "video-hub-business",
            "video-hub-students"
          ]
        },
        "imageAlt": {
          "title": "Image description",
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "item": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "label",
        "app",
        "group",
        "eyebrow",
        "title",
        "body",
        "ctaLabel",
        "ctaHref",
        "imageAssetId",
        "imageAlt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": {
          "title": "Item label",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "group": { "title": "Link group", "type": "string", "maxLength": 80 },
        "app": {
          "enum": [
            "creative-cloud",
            "firefly",
            "acrobat-pro",
            "photoshop",
            "illustrator",
            "premiere-pro",
            "express",
            "lightroom",
            "experience-cloud",
            "stock"
          ]
        },
        "eyebrow": { "$ref": "#/$defs/fields/properties/eyebrow" },
        "title": { "$ref": "#/$defs/fields/properties/title" },
        "body": { "$ref": "#/$defs/fields/properties/body" },
        "ctaLabel": { "$ref": "#/$defs/fields/properties/ctaLabel" },
        "ctaHref": { "$ref": "#/$defs/fields/properties/ctaHref" },
        "imageAssetId": { "$ref": "#/$defs/fields/properties/imageAssetId" },
        "videoAssetId": { "$ref": "#/$defs/fields/properties/videoAssetId" },
        "imageAlt": { "$ref": "#/$defs/fields/properties/imageAlt" }
      }
    }
  }
}
