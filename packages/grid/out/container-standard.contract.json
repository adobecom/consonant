  "decisions": [
    {
      "id": "STD_MAX_1440_OR_1920",
      "question": "Does the standard container cap at 1440 or 1920?",
      "state": "decided",
      "owner": "William Blanton",
      "answer": "Both, by range: 1440 through LG, 1920 from XL. Will's hosted demo implements exactly this, and Figma holds the two behaviours as two families where the 1440-everywhere one is named legacy-retire.",
      "evidence": "acom-prototypes.vercel.app/s2a-grids/grid.css adds @media screen and (width >= 1441px) { .container { max-width: var(--s2a-grid-hd-max-width) } }; Figma containers.default vs containers.legacy-retire in collection 6:178."
    },
    {
      "id": "STD_VS_HD_REDUNDANT",
      "question": "Once the standard container rises to 1920 in HD, is container-hd still a distinct family or does it collapse into this one?",
      "state": "open",
      "owner": "William Blanton",
      "evidence": "The remaining difference is behaviour below HD: container-hd keeps a 1920 cap and the percentage rule from 768 up, where the standard container caps at 1440 until 1441. If no section needs 1920 below HD, the two merge."
    }
