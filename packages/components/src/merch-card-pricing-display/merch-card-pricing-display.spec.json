    {
      "id": "mcpd-archetype-untemplated",
      "question": "The archetype read as \"none\", which has no template in the dictionary (it has: link-card, card, collection, button, checkbox / radio, toggle / switch, input / field, badge / tag / chip, pagination, accordion, select / dropdown, helper text, list). Without one the draft gets no HTML element, no accessibility floor and no base CSS — the root falls back to <div>. Which archetype is this, really?",
      "chose": "drafted with no archetype floor; root element defaults to div",
      "confidence": "low",
      "fix": "Set \"archetype\" in the defs to one the dictionary templates, or re-scaffold with --archetype=<name>. If none fit, the dictionary needs a new entry.",
      "status": "open",
      "owner": "scaffold",
      "evidence": "no signal identified a kind — decide it rather than inheriting a default"
    },
    {
      "id": "mcpd-archetype",
      "question": "Scaffolded as none (no signal identified a kind — decide it rather than inheriting a default). Confirm, or re-run npm run specs:scaffold -- --slug=merch-card-pricing-display --archetype=<link-card|card|collection>.",
      "chose": "none — no signal identified a kind — decide it rather than inheriting a default",
      "confidence": "low",
      "fix": "npm run specs:scaffold -- --slug=merch-card-pricing-display --archetype=<link-card|card|collection> --force",
      "status": "open",
      "owner": "scaffold",
      "alternatives": [
        "link-card: A card that is one link: illustration or icon, a headline, optional description, an arrow affordance. The whole surface is the target and the headline is the accessible name.",
        "card: A non-interactive content card; actions live in a slot.",
        "collection: A row, grid or scroller of one repeated unit.",
        "button: Triggers an action. A label, optional leading and trailing icons, and the full interactive state set.",
        "checkbox / radio: A selection control with a checked state, usually paired with a label.",
        "toggle / switch: A binary on/off control that applies immediately.",
        "input / field: Accepts typed input. Label, value, placeholder, and an error state.",
        "badge / tag / chip: A small label. Non-interactive unless it is dismissible.",
        "pagination: Moves between pages of content.",
        "accordion: A disclosure: a trigger that shows and hides a region of content. Open or closed is a prop a consumer sets, not an interaction state.",
        "select / dropdown: A choice among options. The native <select> does the choosing; the design styles the trigger around it.",
        "helper text: Guidance or a message under a field: hint, error, success. Associated with its field, never floating.",
        "list: A sequence of like items — features, links, steps. The items are the content; the list is the rhythm."
      ],
      "evidence": "decided by heuristic; token namespaces content×2; state axis none"
    },
