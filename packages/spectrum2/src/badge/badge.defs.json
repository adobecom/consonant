  "composition": [
    {
      "name": "S2_Icon_Circle_20_N",
      "treatment": "icon",
      "why": "The placeholder workflow glyph the design drops into the icon slot. It is a member of the icon rig rather than a component in its own right, so it is a category (kind:icon), not a contract."
    }
  ],
  "a11y": {
    "wcag": [
      "1.4.3",
      "1.4.11"
    ],
    "notes": [
      "Colour alone must not carry the meaning; the label does.",
      "Spectrum flips the label and icon colour to black on orange, yellow, chartreuse and celery to hold contrast."
    ]
  },
  "decisions": [
    {
      "id": "b-cjk-line-height",
      "question": "Spectrum sets a different line height for Japanese, Korean and Chinese. The contract shape has no language condition, so it is recorded in a note and lost on render.",
      "chose": "noted on the label part, not expressed",
      "confidence": "low",
      "fix": "Add a conditional keyed on language to the contract shape, or accept that generated code omits it.",
      "status": "open",
      "owner": "Matt",
      "evidence": "@spectrum-css/badge index.css, .spectrum-Badge-label:lang(ja)"
    },
    {
      "id": "b-nonsemantic-colours",
      "question": "Fourteen of the twenty variants are plain colour names with no meaning attached. Do we carry them, or restrict adobe.com to the six semantic ones?",
      "chose": "carried all twenty, matching Spectrum",
      "confidence": "medium",
      "fix": "Narrow the enum if the marketing use only ever needs the semantic set.",
      "status": "open",
      "owner": "Matt",
      "evidence": "index.css, the non-semantic colors comment block"
    },
    {
      "id": "b-implementation",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "Which package is Spectrum 2's Badge?",
      "chose": "@adobe/spectrum-wc (swc-badge)",
      "decision": "The contract describes @adobe/spectrum-wc, the Spectrum 2 web components, for the same reason as Button: the S2 design file's variable names are this package's --swc-* tokens.",
      "fix": "none",
      "evidence": "Badge ships no standalone stylesheet; its CSS is the css`` template in dist/components/badge/badge.js and is vendored unwrapped."
    },
    {
      "id": "b-host-rules",
      "status": "open",
      "confidence": "high",
      "owner": "Matt",
      "question": "Upstream styles the custom element, so size and the semantic variants are :host([size]) and :host([variant]) rules while the nineteen plain colours are .swc-Badge--<colour> classes.",
      "chose": "Re-express both as one variant axis on the root, which is what a light-DOM contract can carry",
      "fix": "If the generated component ever becomes a custom element, drop the re-expression and inherit the host rules.",
      "evidence": "badge.css: :host([variant=\"accent\"]) sets a token; .swc-Badge--blue sets the same token."
    },
    {
      "id": "b-literal-spacing",
      "status": "open",
      "confidence": "high",
      "owner": "Matt",
      "question": "Badge writes its vertical padding and gap as literals, while Button binds tokens that hold exactly those values.",
