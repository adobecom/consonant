{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2a.local/schemas/page-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "locale", "theme", "sections"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "maxLength": 120 },
    "locale": { "const": "en-US" },
    "theme": { "enum": ["light", "dark"] },
    "sections": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/quote" }, { "$ref": "#/$defs/carousel" }, { "$ref": "https://s2a.local/schemas/homepage-section-v1" }]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]{1,80}$" },
    "quoteProps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "attributionName",
        "attributionRole",
        "imageAssetId",
        "showAttribution",
        "showCta"
      ],
      "properties": {
        "quote": {
          "title": "Quote",
          "type": "string",
          "maxLength": 300
        },
        "attributionName": {
          "title": "Name",
          "type": "string",
          "maxLength": 80
        },
        "attributionRole": {
          "title": "Role",
          "type": "string",
          "maxLength": 100
        },
        "imageAssetId": { "enum": ["story-1", "story-2", "story-3", "home-michelle"] },
        "showAttribution": { "title": "Show attribution", "type": "boolean" },
        "showCta": { "title": "Show call to action", "type": "boolean" }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cta"],
      "properties": {
        "cta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "href"],
          "properties": {
            "kind": { "const": "link" },
            "label": { "type": "string", "maxLength": 60 },
            "href": {
              "type": "string",
              "maxLength": 2048,
              "format": "safe-link"
            }
          }
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "componentVersion", "props", "slots"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "component": { "const": "quote-card" },
        "componentVersion": { "const": 1 },
        "props": { "$ref": "#/$defs/quoteProps" },
        "slots": { "$ref": "#/$defs/slots" }
      }
    },
    "carousel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "componentVersion", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "component": { "const": "social-proof-carousel" },
        "componentVersion": { "const": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/quote" }
        }
      }
    }
  }
}
