{
  "$schema": "../../../spec-dictionary/southleft/contract.schema.json",
  "id": "spectrum.icon",
  "name": "Icon",
  "version": "2.0.0",
  "status": "draft",
  "description": "A glyph at a size, inheriting its colour. Spectrum's smallest leaf: 36 of its 84 components depend on it.",
  "semantics": {
    "element": "span"
  },
  "props": [
    {
      "name": "size",
      "type": {
        "enum": [
          "xs",
          "s",
          "m",
          "l",
          "xl"
        ]
      },
      "description": "Five rungs, one more than the other components: the icon adds xs.",
      "default": "\"m\"",
      "bindings": {
        "figma": {
          "kind": "NONE",
          "property": "—"
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "accessibleLabel",
      "type": "text",
      "description": "When empty the host is marked aria-hidden and the glyph is decorative; when set the host is exposed as an image with that label.",
      "bindings": {
        "figma": {
          "kind": "NONE",
          "property": "—"
        },
        "code": {
          "prop": "accessibleLabel"
        }
      }
    }
  ],
  "anatomy": {
    "root": {
      "element": "span",
      "tokens": {
        "inline-size": "{swc.workflow.icon.medium}",
        "block-size": "{swc.workflow.icon.medium}"
      },
      "literals": {
        "box-sizing": "border-box",
        "display": "block",
        "color": "currentColor"
      },
      "tokensByProp": [
        {
          "prop": "size",
          "map": {
            "xs": {
              "inline-size": "{swc.workflow.icon.extra-small}",
              "block-size": "{swc.workflow.icon.extra-small}"
            },
            "s": {
              "inline-size": "{swc.workflow.icon.small}",
              "block-size": "{swc.workflow.icon.small}"
            },
            "m": {
              "inline-size": "{swc.workflow.icon.medium}",
              "block-size": "{swc.workflow.icon.medium}"
            },
            "l": {
              "inline-size": "{swc.workflow.icon.large}",
              "block-size": "{swc.workflow.icon.large}"
            },
            "xl": {
              "inline-size": "{swc.workflow.icon.extra-large}",
              "block-size": "{swc.workflow.icon.extra-large}"
            }
          }
        }
      ],
      "parts": {
        "glyph": {
          "element": "svg",
          "literals": {
            "display": "block",
            "inline-size": "100%",
            "block-size": "100%",
            "fill": "currentColor",
            "--iconPrimary": "currentColor"
          },
          "slot": {
            "name": "glyph",
            "accepts": [
              "kind:icon"
            ],
            "acceptsMode": "restrict",
            "defaultContent": [
