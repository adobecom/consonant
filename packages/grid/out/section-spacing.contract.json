  "rules": [
    {
      "id": "SEC_SCALE_SHIPPED",
      "statement": "Every step of the section-spacing scale ships in the built token CSS. A gap in the scale is how a block ends up with a literal.",
      "severity": "fail",
      "check": {
        "type": "tokenShipped",
        "ref": "{s2a.section-spacing.5xl}"
      }
    },
    {
      "id": "SEC_NONE_SHIPPED",
      "statement": "The scale includes an explicit zero, so 'no gap' is a choice from the system rather than the absence of one.",
      "severity": "fail",
      "check": {
        "type": "tokenShipped",
        "ref": "{s2a.section-spacing.none}"
      }
    },
    {
      "id": "SEC_PADDING_SHIPPED",
      "statement": "The viewport vertical padding scale ships.",
      "severity": "fail",
      "check": {
        "type": "tokenShipped",
        "ref": "{s2a.viewport-vertical-padding.xl}"
      }
    },
    {
      "id": "SEC_FIGMA_XL_5XL",
      "statement": "Figma's HD mode agrees that the largest section gap is 240px.",
      "severity": "fail",
      "check": {
        "type": "figmaAgrees",
        "figmaPath": "section-spacing.5xl",
        "mode": "xl",
        "expected": 240
      }
    },
    {
      "id": "SEC_FIGMA_SM_5XL",
      "statement": "Figma's mobile mode compresses the largest section gap to 80px.",
      "severity": "fail",
      "check": {
        "type": "figmaAgrees",
        "figmaPath": "section-spacing.5xl",
        "mode": "sm",
        "expected": 80
      }
    },
    {
      "id": "SEC_MONOTONIC_XL",
      "statement": "The scale never goes backwards: at every breakpoint each step is greater than or equal to the one below it. Will found 2xl and 3xl inverted in the spacers once already.",
      "severity": "fail",
      "check": {
        "type": "manual",
        "note": "Checked by the validator across all four modes; see the conformance report. At md, 3xl (64) is smaller than 2xl (80) — recorded as a finding rather than silently tolerated."
      }
    },
    {
      "id": "SEC_MD_BOUNDARY",
      "statement": "The md token file begins at 768, not 1024. The 1024 value flipped sectional spacing a whole range early and shipped for months.",
      "severity": "fail",
      "check": {
        "type": "boundaryAgreement",
        "breakpoint": "md",
        "expected": 768
      }
    }
  ],
  "decisions": [
    {
      "id": "SEC_MD_INVERSION",
      "question": "At the tablet breakpoint, section-spacing 3xl resolves to 64px while 2xl resolves to 80px — the scale inverts. Intended or a mapping slip?",
      "state": "open",
      "owner": "William Blanton",
      "evidence": "From the Figma modes: md 2xl = {s2a.layout.sm} = 80, md 3xl = {s2a.spacing.4xl} = 64. At every other breakpoint 3xl is greater than or equal to 2xl. Will has found and fixed one spacer dupe like this before."
    },
    {
      "id": "SEC_SPACER_ROLES",
      "question": "Will's cheat sheet names ten spacer roles — Base Top/Bottom, Grid Bottom, Blocks Gap, Cards Bottom, Cards Gap, CTA Top/Bottom, Pothole, Rich Content Bottom — each with four per-breakpoint values. Should those roles become semantic tokens that alias the scale, so a block says 'cta-top' rather than picking a step?",
      "state": "open",
      "owner": "William Blanton",
      "evidence": "They exist in Figma as _c2.design-spacers.* and are stripped as design-only. Naming the role is what would stop each block choosing its own step, which is the drift Will keeps auditing."
    }
  ],
  "visualize": {
    "demo": "spacing",
