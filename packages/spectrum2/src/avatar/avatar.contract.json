{
  "$schema": "../../../spec-dictionary/southleft/contract.schema.json",
  "id": "spectrum.avatar",
  "name": "Avatar",
  "version": "2.0.0",
  "status": "draft",
  "description": "A person or entity, as a circular image. Static: it is a picture, not a control.",
  "archetype": "avatar",
  "semantics": {
    "element": "span"
  },
  "props": [
    {
      "name": "size",
      "type": {
        "enum": [
          "50",
          "75",
          "100",
          "200",
          "300",
          "400",
          "500",
          "600",
          "700",
          "800",
          "900",
          "1000",
          "1100",
          "1200",
          "1300",
          "1400",
          "1500"
        ]
      },
      "description": "Seventeen rungs. The design file labels each with its pixel box, 50 (16x16); the code value is the rung alone.",
      "default": "\"500\"",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "valueMap": {
            "50": "50 (16x16)",
            "75": "75 (20x20)",
            "100": "100 (24x24)",
            "200": "200 (28x28)",
            "300": "300 (32x32)",
            "400": "400 (36x36)",
            "500": "500 (40x40)",
            "600": "600 (44x44)",
            "700": "700 (48x48)",
            "800": "800 (52x52)",
            "900": "900 (56x56)",
            "1000": "1000 (64x64)",
            "1100": "1100 (72x72)",
            "1200": "1200 (80x80)",
            "1300": "1300 (88x88)",
            "1400": "1400 (96x96)",
            "1500": "1500 (104x104)"
          }
        },
        "code": {
          "prop": "size"
        }
      }
    },
    {
      "name": "src",
      "type": "text",
      "description": "URL of the image. The design file has no counterpart: it draws sample content instead.",
      "bindings": {
        "figma": {
          "kind": "NONE",
          "property": "—"
        },
        "code": {
          "prop": "src"
        }
      }
    },
    {
      "name": "alt",
      "type": "text",
      "description": "Describes the person or entity. An empty string marks the image decorative and hides it from assistive technology.",
      "bindings": {
        "figma": {
          "kind": "NONE",
          "property": "—"
        },
        "code": {
          "prop": "alt"
        }
      }
    },
    {
      "name": "outline",
      "type": "boolean",
      "description": "A ring around the image, for avatars that overlap or sit on a busy ground.",
      "default": "false",
      "bindings": {
        "figma": {
          "kind": "BOOLEAN",
          "property": "Show stroke"
        },
        "code": {
          "prop": "outline"
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": "false",
      "bindings": {
        "figma": {
          "kind": "VARIANT",
          "property": "State",
          "valueMap": {
            "true": "Disabled",
            "false": "Default"
          }
        },
        "code": {
          "prop": "disabled"
        }
      }
    },
    {
      "name": "decorative",
      "type": "boolean",
      "description": "Hides the image from assistive technology without clearing alt.",
      "default": "false",
      "bindings": {
        "figma": {
          "kind": "NONE",
          "property": "—"
        },
        "code": {
          "prop": "decorative"
        }
      }
    }
  ],
  "states": [
