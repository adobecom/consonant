  "decisions": [
    {
      "id": "i-no-design-anchor",
      "question": "Spectrum ships no Icon component set in Figma, so this contract has code evidence only. Accept a code-first contract, or wait for a design anchor that may never exist?",
      "chose": "accepted code-first; anchors.figma.kind is \"none\"",
      "confidence": "medium",
      "fix": "If Spectrum later publishes an Icon set, re-anchor and re-extract.",
      "status": "open",
      "owner": "scaffold",
      "evidence": "S2 / Web lists 142 component sets and none is Icon."
    },
    {
      "id": "i-scale-axis",
      "question": "Spectrum's tokens carry a scale axis (medium and large) that S2A does not have; the same token resolves to 20px and 24px. Which scale does adobe.com bind to?",
      "chose": "medium, matching desktop web",
      "confidence": "medium",
      "fix": "If a surface needs large scale, the token directory gains a second mode rather than the contract gaining a prop.",
      "status": "open",
      "owner": "Matt",
      "evidence": "@spectrum-css/tokens 16.0.2 medium-vars.css and large-vars.css"
    },
    {
      "id": "i-implementation",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "Which package is Spectrum 2's Icon?",
      "chose": "@adobe/spectrum-wc (swc-icon)",
      "decision": "The contract describes @adobe/spectrum-wc. Icon has no module of its own beyond a slot and a size box; its stylesheet is shared, at dist/stylesheets/_lit-styles/icon-base.js.",
      "fix": "none",
      "evidence": "Icon.js imports icon-base.js for its only styles and renders a single default slot."
    },
    {
      "id": "i-host-rules",
      "status": "open",
      "confidence": "high",
      "owner": "Matt",
      "question": "Every rule in the icon stylesheet is :host or ::slotted — there is not one class in it.",
      "chose": "Declare swc-Icon as the root class and re-express the host rules on it",
      "fix": "If the generated component becomes a custom element, drop the class and inherit the host rules.",
      "evidence": "icon-base.css is :host, :host([size]), and svg,::slotted(*) only. The class is ours, which is why the anatomy cannot be checked against the stylesheet."
    },
    {
      "id": "i-override-seam",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "How does a consumer resize or recolour the icon?",
      "chose": "--swc-icon-inline-size, --swc-icon-block-size and --swc-icon-color",
      "decision": "Upstream exposes three custom properties on the host and derives everything else from them, so the size prop and a direct override reach the same place.",
      "fix": "none",
      "evidence": "icon-base.css declares all three on :host with the size attribute switching the first two."
    },
    {
      "id": "i-glyph-fill",
      "status": "decided",
      "confidence": "high",
      "owner": "Matt",
      "question": "Every glyph rendered in its own colour instead of the component's.",
      "chose": "Map the artwork's own hook to currentColor on the part that holds the glyph",
      "decision": "Spectrum's workflow SVGs paint with fill=\"var(--iconPrimary, #222)\" rather than currentColor, so with nothing defining that property every glyph fell back to #222 regardless of the colour around it. Setting --iconPrimary to currentColor on the icon part makes a glyph follow its component, and leaves the property available to anyone who wants a different colour.",
      "fix": "none. The alternative was rewriting 396 vendored SVGs, which would mean editing artwork we do not own.",
      "evidence": "All 396 entries in spectrum-icons.json carry var(--iconPrimary, #222); all 26 in our own s2a-icons.json use currentColor. Measured: the badge's text was #ffffff while its glyph painted #222222."
    }
